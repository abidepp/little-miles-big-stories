---
// "/about". All the words and the photo come from src/content/pages/about/index.md,
// which is edited in the editor under Site pages → About Us.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE_PHILOSOPHY, SITE_TAGLINE } from '../consts';
import { getPage, getSocial } from '../utils/journals';

const about = await getPage('about');
const social = await getSocial();
const { Content } = await render(about);
const { title, intro, photo, photoAlt, facts } = about.data;
---

<SiteLayout title="About Us" description={intro ?? 'Meet the family behind Little Miles, Big Stories.'}>
	<section class="wrap intro">
		<div class="intro-text">
			<p class="label">About us</p>
			<h1>{title}</h1>
			{intro && <p class="lede">{intro}</p>}
		</div>
		<div class="intro-photo">
			{
				photo ? (
					<Image src={photo} alt={photoAlt ?? ''} widths={[500, 900, 1200]} sizes="(max-width: 760px) 100vw, 540px" loading="eager" />
				) : (
					<div class="photo-placeholder" aria-hidden="true">
						<span>Our family photo goes here</span>
					</div>
				)
			}
		</div>
	</section>

	<section class="section wrap-text story">
		<h2>Our story</h2>
		<div class="story-body">
			<Content />
		</div>
		<p class="philosophy">{SITE_PHILOSOPHY}</p>
		<p class="script tagline">{SITE_TAGLINE}</p>
	</section>

	{
		facts && facts.length > 0 && (
			<section class="wrap facts" aria-labelledby="facts-title">
				<h2 id="facts-title">A few things about us</h2>
				<dl>
					{facts.map((fact) => (
						<div>
							<dt class="label">{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))}
				</dl>
			</section>
		)
	}

	<section class="section wrap-text cta">
		<h2>Come along for the journey</h2>
		<div class="actions">
			<a href="/journals" class="btn btn-primary">Read our journals</a>
			<a href={social.instagram} class="btn" target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a>
		</div>
	</section>
</SiteLayout>

<style>
	.intro {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: clamp(28px, 6vw, 80px);
		align-items: center;
		padding-block: clamp(40px, 7vw, 80px);
	}
	.intro h1 {
		font-size: clamp(2.4rem, 6vw, 4rem);
		margin-block: 10px 18px;
	}
	.intro-photo img,
	.photo-placeholder {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
	}
	.photo-placeholder {
		display: grid;
		place-items: center;
		background: var(--sand);
		color: var(--muted);
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.4rem;
	}

	.story h2 {
		font-size: clamp(2rem, 4.5vw, 2.6rem);
		margin-bottom: 20px;
	}
	.story-body {
		font-size: 1.125rem;
		line-height: 1.8;
	}
	.story-body :global(p + p) {
		margin-top: 1.1em;
	}
	.philosophy {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.5rem;
		line-height: 1.4;
		text-align: center;
		margin-top: 48px;
	}
	.tagline {
		text-align: center;
		font-size: 1.6rem;
		margin-top: 12px;
	}

	.facts {
		background: var(--sand-soft);
		padding-block: clamp(40px, 6vw, 64px);
		text-align: center;
	}
	.facts h2 {
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		margin-bottom: 28px;
	}
	.facts dl {
		display: grid;
		gap: 24px;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
	}
	.facts dd {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		margin-top: 6px;
	}

	.cta {
		text-align: center;
	}
	.cta h2 {
		font-size: clamp(2rem, 4.5vw, 2.6rem);
		margin-bottom: 24px;
	}
	.cta .actions {
		justify-content: center;
	}

	@media (max-width: 760px) {
		.intro {
			grid-template-columns: 1fr;
		}
	}
</style>
