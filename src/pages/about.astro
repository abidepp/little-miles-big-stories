---
// src/pages/about.astro  ->  "/about"
// Edit the text in [square brackets] so it's in your own words.

import SiteLayout from '../layouts/SiteLayout.astro';
import { INSTAGRAM_URL, LINKTREE_URL } from '../consts';

// To add a family photo: put it in src/assets/images/, then import it, e.g.
//   import familyPhoto from '../assets/images/family.jpg';
// and swap the placeholder below for <Image src={familyPhoto} alt="..." />
// (import { Image } from 'astro:assets'). Imported images get optimised automatically.
const familyPhoto = null;

const whatYoullFind = [
	{ icon: '📖', title: 'Honest journals', text: 'A new trip story every month: what we did, what worked, and what we\'d skip next time.' },
	{ icon: '🧸', title: 'Little-one friendly tips', text: 'Buggy-friendly paths, nap-time planning, snack stops and places that welcome small children.' },
	{ icon: '📍', title: 'Places worth the miles', text: 'Our favourite parks, beaches, castles and cafés, so you can plan your own family days out.' },
];

const funFacts = [
	{ label: 'Home base', value: '[Your town], UK' },
	{ label: 'Originally from', value: 'India' },
	{ label: 'Travel crew', value: '[2 grown-ups + 1 little explorer]' },
	{ label: "Can't travel without", value: '[Snacks. Always snacks.]' },
];
---

<SiteLayout title="About us" description="Meet the family behind Little Miles, Big Smiles.">
	<section class="intro">
		<div class="intro-text">
			<p class="eyebrow">About us</p>
			<h1>Hello, we're the family behind the miles 👋</h1>
			<p class="lede">
				[We're a family of three who moved from India to the UK and decided to explore our new home one little trip at a
				time.]
			</p>
		</div>
		<div class="intro-photo">
			{familyPhoto ?? <div class="img-placeholder" aria-hidden="true">👨‍👩‍👧</div>}
		</div>
	</section>

	<section class="story">
		<h2>Our story</h2>
		<p>
			[When we moved to the UK, everything was new: the weather, the trains, the endless choice of places to visit. With a
			little one in tow, every outing felt like a small adventure, and every adventure came with a story worth
			remembering.]
		</p>
		<p>
			[We started this journal to keep those memories in one place, and to share what we've learned along the way.
			Travelling with a young child isn't always smooth, but the little moments (the first glimpse of the sea, a picnic in
			the rain, a new favourite playground) make every mile worth it.]
		</p>
		<p>
			[Whether you're new to the UK, planning your first family trip, or just looking for ideas for the weekend, we hope
			our stories help you find your own big smiles.]
		</p>
	</section>

	<section class="section">
		<h2 class="section-title">What you'll find here</h2>
		<div class="features">
			{
				whatYoullFind.map((item) => (
					<div class="feature">
						<p class="feature-icon" aria-hidden="true">{item.icon}</p>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="facts">
		<h2>A few things about us</h2>
		<dl>
			{
				funFacts.map((f) => (
					<div class="fact">
						<dt>{f.label}</dt>
						<dd>{f.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="section cta">
		<h2>Come along for the journey</h2>
		<p>Everyday snaps live on Instagram, and a new journal arrives here every month.</p>
		<div class="actions">
			<a href="/journals" class="btn btn-primary">Read our journals</a>
			<a href={INSTAGRAM_URL} class="btn btn-ghost" target="_blank" rel="noopener">Instagram</a>
			<a href={LINKTREE_URL} class="btn btn-ghost" target="_blank" rel="noopener">All our links</a>
		</div>
	</section>
</SiteLayout>

<style>
	.intro {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 40px;
		align-items: center;
		padding: 48px 0;
	}
	.eyebrow {
		margin-bottom: 10px;
	}
	.intro h1 {
		font-size: clamp(2rem, 5.5vw, 3.2rem);
		margin-bottom: 16px;
	}
	.intro-photo {
		height: 360px;
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow);
		transform: rotate(1.5deg);
	}
	.intro-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.intro-photo .img-placeholder {
		font-size: 5rem;
	}

	.story {
		max-width: 720px;
		margin: 0 auto;
		padding: 40px 0;
	}
	.story h2 {
		font-size: 1.9rem;
		margin-bottom: 18px;
	}
	.story p {
		font-size: 1.08rem;
		margin-bottom: 18px;
	}

	.section-title {
		text-align: center;
	}
	.features {
		display: grid;
		gap: 24px;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}
	.feature {
		background: var(--surface);
		border-radius: var(--radius);
		padding: 28px 24px;
		box-shadow: var(--shadow);
	}
	.feature-icon {
		font-size: 2.2rem;
		margin-bottom: 10px;
	}
	.feature h3 {
		font-size: 1.25rem;
		margin-bottom: 8px;
	}
	.feature p {
		color: var(--muted);
	}

	.facts {
		background: var(--soft);
		border-radius: var(--radius);
		padding: 48px 24px;
		margin: 24px 0;
		text-align: center;
	}
	.facts h2 {
		font-size: 1.8rem;
		margin-bottom: 28px;
	}
	.facts dl {
		display: grid;
		gap: 16px;
		max-width: 900px;
		margin: 0 auto;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
	}
	.fact {
		background: var(--surface);
		border-radius: 14px;
		padding: 18px 16px;
	}
	.fact dt {
		font-size: 0.8rem;
		color: var(--teal);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 4px;
	}
	.fact dd {
		font-weight: 700;
	}

	.cta {
		text-align: center;
	}
	.cta h2 {
		font-size: 1.8rem;
		margin-bottom: 8px;
	}
	.cta p {
		color: var(--muted);
		margin-bottom: 24px;
	}
	.cta .actions {
		justify-content: center;
	}

	@media (max-width: 760px) {
		.intro {
			grid-template-columns: 1fr;
			gap: 28px;
			padding: 32px 0;
		}
		.intro-photo {
			height: 260px;
			transform: none;
		}
	}
</style>
