---
// src/pages/index.astro  ->  "/"
//
// DATA FLOW, STEP 3: a page asks for data, then hands it to components.
//   content.config.ts (schema) -> getJournals() -> this page -> <JournalCard journal={...} />

import SiteLayout from '../layouts/SiteLayout.astro';
import JournalCard from '../components/JournalCard.astro';
import { getJournals } from '../utils/journals';
import { SITE_DESCRIPTION, INSTAGRAM_URL, LINKTREE_URL } from '../consts';

const journals = await getJournals(); // already newest first
const featured = journals[0];
const recent = journals.slice(1, 7);
---

<SiteLayout>
	<section class="hero">
		<p class="eyebrow">A family travel journal</p>
		<h1>Little miles.<br />Big smiles.</h1>
		<p class="lede">
			{SITE_DESCRIPTION} Real trips, honest tips and the small moments that make travelling with little ones worth it.
		</p>
		<div class="actions">
			<a href="#latest" class="btn btn-primary">Read the journals</a>
			<a href="/about" class="btn btn-ghost">Meet the family</a>
		</div>
	</section>

	<section id="latest" class="section">
		<h2 class="section-title">Latest journal</h2>
		{
			featured ? (
				<JournalCard journal={featured} featured />
			) : (
				<div class="empty">
					<p class="empty-icon" aria-hidden="true">🗺️</p>
					<h3>Our first story is on its way</h3>
					<p>New journals land every month. Follow along on Instagram in the meantime.</p>
					<a href={INSTAGRAM_URL} class="btn btn-primary" target="_blank" rel="noopener">Follow on Instagram</a>
				</div>
			)
		}
	</section>

	{
		recent.length > 0 && (
			<section class="section">
				<h2 class="section-title">More stories</h2>
				<div class="grid">
					{recent.map((journal) => (
						<JournalCard journal={journal} />
					))}
				</div>
				<div class="actions center">
					<a href="/journals" class="btn btn-ghost">See all journals</a>
				</div>
			</section>
		)
	}

	<section class="about">
		<h2>Hello, we're the family behind the miles 👋</h2>
		<p>
			We swapped India for the UK and decided to explore our new home one trip at a time, with a little one in tow. This
			is where we keep our stories, tips and favourite places, so you can plan your own family adventures with a bit
			more confidence.
		</p>
		<a href="/about" class="btn btn-primary">Our story</a>
	</section>

	<section class="section cta">
		<h2>Follow the journey</h2>
		<p>Day-to-day snaps and stories live on Instagram. A new journal arrives here every month.</p>
		<div class="actions center">
			<a href={INSTAGRAM_URL} class="btn btn-primary" target="_blank" rel="noopener">Instagram</a>
			<a href={LINKTREE_URL} class="btn btn-ghost" target="_blank" rel="noopener">All our links</a>
		</div>
	</section>
</SiteLayout>

<style>
	.hero {
		padding-block: clamp(40px, 8vw, 64px) clamp(32px, 6vw, 48px);
		max-width: 720px;
	}
	.hero h1 {
		font-size: clamp(2.4rem, 7vw, 4rem);
		margin-bottom: 20px;
	}
	.hero .lede {
		margin-bottom: 28px;
	}

	.center {
		justify-content: center;
		margin-top: 32px;
	}

	.empty {
		text-align: center;
		padding: 56px 24px;
		background: var(--surface);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
	.empty-icon {
		font-size: 3rem;
		margin-bottom: 8px;
	}
	.empty h3 {
		font-size: 1.5rem;
		margin-bottom: 8px;
	}
	.empty p {
		color: var(--muted);
		margin-bottom: 20px;
	}

	.about {
		background: var(--soft);
		border-radius: var(--radius);
		margin: 24px 0;
		padding: 56px 24px;
		text-align: center;
	}
	.about > * {
		max-width: 680px;
		margin-inline: auto;
	}
	.about h2 {
		font-size: 1.8rem;
		margin-bottom: 16px;
	}
	.about p {
		color: var(--muted);
		margin-bottom: 24px;
	}

	.cta {
		text-align: center;
	}
	.cta h2 {
		font-size: 1.8rem;
		margin-bottom: 8px;
	}
	.cta p {
		color: var(--muted);
	}
</style>
