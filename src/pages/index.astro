---
// "/" — Home (About me). Every word comes from src/content/pages/home/index.md
// (editor: Pages → Home). The main button leads to Our story.
//
// DATA FLOW: Markdown file -> content.config.ts (checked) -> getSingle('home') -> this page.
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { getSingle } from '../utils/content';

const home = await getSingle('home');
const { Content } = await render(home); // the paragraphs
const { label, heading, photo, photoAlt, photoNote, quote, button, banner } = home.data;

const og = photo ? (await getImage({ src: photo, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src : undefined;
---

<SiteLayout
	description="Little Miles, Big Stories: a family travel journal by Ish. Honest, free PDF journals on travelling with a little one."
	image={og}
>
	<section class="container section split about">
		<div class="about-photo">
			<Photo src={photo} alt={photoAlt} placeholder="Photo: Ish on a trip (portrait)" ratio="4 / 5" eager>
				{photoNote && <p class="note hand">{photoNote}</p>}
			</Photo>
		</div>

		<div class="about-text">
			<p class="label">{label}</p>
			<h1 class="h-lg">{heading}</h1>
			<div class="paragraphs">
				<Content />
			</div>
			{quote && <blockquote class="hand quote">{quote}</blockquote>}
			<a href={button.url} class="btn">
				{button.label} <Icon name="arrow" size={18} />
			</a>
		</div>
	</section>

	{
		banner && (
			<div class="container">
				<a href={banner.url} class="banner">
					<span class="label banner-tag">{banner.tag}</span>
					<span class="banner-text">{banner.text}</span>
					<Icon name="arrow" size={20} />
				</a>
			</div>
		)
	}
</SiteLayout>

<style>
	.about {
		padding-bottom: clamp(40px, 6vw, 64px);
	}
	.about-photo {
		position: relative;
		/* leave room for the note that hangs off the photo */
		padding-bottom: 28px;
	}
	.note {
		position: absolute;
		right: clamp(-8px, -1vw, 0px);
		bottom: -28px;
		max-width: 15rem;
		padding: 12px 18px;
		background: var(--white);
		border: 1px solid var(--sand);
		border-radius: 14px;
		box-shadow: 0 8px 24px rgba(59, 42, 32, 0.08);
		font-size: 1.45rem;
		color: var(--caramel);
		transform: rotate(-3deg);
	}
	.about-text .label {
		margin-bottom: 14px;
	}
	.about-text h1 {
		margin-bottom: 22px;
	}
	.paragraphs {
		color: var(--cocoa);
	}
	.paragraphs :global(p + p) {
		margin-top: 1em;
	}
	.quote {
		margin-block: 28px 32px;
		padding-left: 18px;
		border-left: 3px solid var(--biscuit);
		font-size: clamp(1.6rem, 3vw, 2rem);
		color: var(--espresso);
	}

	.banner {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px 18px;
		margin-bottom: var(--section);
		padding: 22px clamp(20px, 4vw, 36px);
		border-radius: var(--radius-card);
		background: var(--latte);
		color: var(--espresso);
		transition: background 0.2s;
	}
	.banner:hover {
		background: var(--biscuit);
	}
	.banner-tag {
		padding: 5px 12px;
		border-radius: var(--radius-pill);
		background: var(--espresso);
		color: var(--white);
		letter-spacing: 0.12em;
	}
	.banner-text {
		flex: 1;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.7rem);
		font-weight: 700;
		line-height: 1.2;
		min-width: 14rem;
	}
</style>
