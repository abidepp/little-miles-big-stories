import SiteLayout from '../layouts/SiteLayout.astro';
import CategoryListing from '../components/CategoryListing.astro';
import { CATEGORIES } from '../consts';
---

<SiteLayout title={CATEGORIES['family-travel'].label} description={CATEGORIES['family-travel'].intro}>
	<CategoryListing category="family-travel" />
</SiteLayout>
