---
// "/contact": form, Instagram, email.
// Copy: src/content/pages/contact/index.md. Instagram, email and the form key:
// src/content/pages/site/index.md (editor: Pages → Site settings).
//
// The site is static (no server), so the form sends straight from the visitor's
// browser to Web3Forms (web3forms.com, free), which emails it to Ish. Its access key
// is designed to be public; it can only send messages to the inbox it was created for.
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { getSingle, instagramUrl, isPlaceholder } from '../utils/content';

const { data } = await getSingle('contact');
const { data: site } = await getSingle('site');
const emailReady = site.email && !isPlaceholder(site.email) && site.email.includes('@');
---

<SiteLayout title="Contact" description={data.text}>
	<section class="container section split contact">
		<div>
			<p class="label">Contact</p>
			<h1 class="h-xl">{data.heading}</h1>
			<p class="lede">{data.text}</p>

			<ul class="channels">
				<li>
					<a href={instagramUrl(site.instagramHandle)} target="_blank" rel="noopener">
						<Icon name="instagram" size={22} /> Instagram @{site.instagramHandle}
					</a>
				</li>
				{
					site.email && (
						<li>
							{emailReady ? (
								<a href={`mailto:${site.email}`}>
									<Icon name="mail" size={22} /> {site.email}
								</a>
							) : (
								<span>
									<Icon name="mail" size={22} /> {site.email}
								</span>
							)}
						</li>
					)
				}
			</ul>
		</div>

		<form class="card form" data-contact-form data-key={site.contactFormKey ?? ''} novalidate>
			<div class="field">
				<label for="name">Your name</label>
				<input id="name" name="name" type="text" autocomplete="name" required />
			</div>
			<div class="field">
				<label for="email">Email</label>
				<input id="email" name="email" type="email" autocomplete="email" required />
			</div>
			<div class="field">
				<label for="message">Message</label>
				<textarea id="message" name="message" rows="6" required></textarea>
			</div>

			<!-- Spam trap: hidden from people, bots tick it, Web3Forms drops those messages -->
			<input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<button type="submit" class="btn">
				<Icon name="send" size={18} /> Send message
			</button>
			<p class="status" role="status" aria-live="polite" data-status></p>
			<p class="privacy">{data.privacy}</p>
		</form>
	</section>
</SiteLayout>

<script>
	// Runs in the visitor's browser (unlike the --- block above, which runs at build time).
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const status = form?.querySelector<HTMLElement>('[data-status]');
	const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	function show(message: string, kind: 'ok' | 'error' | 'busy') {
		if (!status) return;
		status.textContent = message;
		status.dataset.kind = kind;
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		const key = form.dataset.key;
		if (!key) {
			show('Our contact form isn’t switched on yet. Please message us on Instagram in the meantime.', 'error');
			return;
		}

		const fields = new FormData(form);
		button!.disabled = true;
		show('Sending…', 'busy');

		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify({
					access_key: key,
					subject: 'New message from Little Miles, Big Stories',
					from_name: 'Little Miles, Big Stories website',
					name: fields.get('name'),
					email: fields.get('email'),
					message: fields.get('message'),
					botcheck: fields.get('botcheck') ? true : '',
				}),
			});
			const result = await response.json();
			if (!response.ok || !result.success) throw new Error(result.message);
			form.reset();
			show('Thank you! Your message is on its way. We’ll reply soon.', 'ok');
		} catch {
			show('Sorry, that didn’t send. Please try again, or message us on Instagram.', 'error');
		} finally {
			button!.disabled = false;
		}
	});
</script>

<style>
	.contact {
		align-items: start;
	}
	.label {
		margin-bottom: 14px;
	}
	h1 {
		margin-bottom: 18px;
	}
	.channels {
		list-style: none;
		display: grid;
		gap: 6px;
		margin-top: 28px;
	}
	.channels a,
	.channels span {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding-block: 8px;
		font-weight: 700;
	}
	.channels a {
		color: var(--caramel);
	}
	.channels a:hover {
		color: var(--caramel-dark);
	}

	.form {
		display: grid;
		gap: 18px;
	}
	.field {
		display: grid;
		gap: 6px;
	}
	label {
		font-weight: 700;
		font-size: 0.95rem;
	}
	input,
	textarea {
		width: 100%;
		font: inherit;
		font-size: 1rem; /* 16px+ stops iPhones zooming in on tap */
		color: var(--espresso);
		background: var(--white);
		border: 1px solid var(--sand);
		border-radius: 12px;
		padding: 12px 14px;
	}
	textarea {
		resize: vertical;
	}
	input:focus,
	textarea:focus {
		outline: 2px solid var(--caramel);
		outline-offset: 1px;
		border-color: var(--caramel);
	}
	.trap {
		display: none;
	}
	.btn {
		justify-self: start;
	}
	.btn:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.status:empty {
		display: none;
	}
	.status {
		font-weight: 700;
	}
	.status[data-kind='ok'] {
		color: #2f6b3a;
	}
	.status[data-kind='error'] {
		color: #9a3b26;
	}
	.privacy {
		font-size: 0.85rem;
		color: var(--cocoa);
		padding-top: 14px;
		border-top: 1px solid var(--sand);
	}
</style>
