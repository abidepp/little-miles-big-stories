---
// "/journals/<slug>": a journal's own page. The build guide calls this "later", for
// when there's more to show than a card. It's ready now: a page is built automatically
// for any "out now" journal whose Article box (the Markdown body) has text in it.
// Until then the journal is just a card on /journals.
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Photo from '../../components/Photo.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Icon from '../../components/Icon.astro';
import { getJournals, hasPage, type Journal } from '../../utils/content';

export async function getStaticPaths() {
	const journals = (await getJournals()).filter(hasPage);
	return journals.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
	entry: Journal;
}

const { entry } = Astro.props;
const { title, tags, summary, cover, coverAlt, pdf } = entry.data;
const { Content } = await render(entry);

const og = cover ? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src : undefined;
const pageURL = new URL(`/journals/${entry.id}`, Astro.site).href;
---

<SiteLayout title={title} description={summary ?? title} image={og}>
	<article>
		<header class="container head">
			<a href="/journals" class="back"><span aria-hidden="true">←</span> All journals</a>
			<ul class="tags">{tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
			<h1 class="h-xl">{title}</h1>
			{summary && <p class="lede">{summary}</p>}
		</header>

		<div class="container">
			<Photo src={cover} alt={coverAlt} placeholder={`Cover photo: ${title}`} ratio="16 / 9" sizes="(max-width: 1248px) 100vw, 1200px" eager />
		</div>

		<div class="container prose">
			<Content />
		</div>

		<div class="container end">
			{
				pdf && (
					<div class="pdf">
						<p class="h-md">The full journal, free as a PDF.</p>
						<a href={pdf} class="btn" download>
							<Icon name="download" size={18} /> Download the PDF
						</a>
					</div>
				)
			}
			<ShareButtons url={pageURL} title={title} image={og ? new URL(og, Astro.site).href : undefined} />
		</div>
	</article>
</SiteLayout>

<style>
	.head {
		max-width: 52rem;
		padding-block: clamp(32px, 6vw, 64px) clamp(28px, 4vw, 40px);
		text-align: center;
	}
	.back {
		display: inline-block;
		margin-bottom: 24px;
		font-weight: 700;
		color: var(--caramel);
	}
	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin-bottom: 18px;
	}
	.head h1 {
		margin-bottom: 16px;
	}

	/* The Markdown's HTML isn't written in this file, so :global() is needed to style it */
	.prose {
		max-width: 46rem;
		padding-block: clamp(40px, 6vw, 64px);
		font-size: 1.1rem;
		line-height: 1.75;
	}
	.prose > :global(* + *) {
		margin-top: 1.2em;
	}
	.prose :global(h2) {
		font-size: clamp(1.9rem, 4vw, 2.4rem);
		margin-top: 2em;
	}
	.prose :global(h3) {
		font-size: 1.5rem;
		margin-top: 1.6em;
	}
	.prose :global(a) {
		color: var(--caramel);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.3em;
	}
	.prose :global(img) {
		width: 100%;
		border-radius: var(--radius-photo);
	}
	.prose :global(blockquote) {
		font-family: var(--font-script);
		font-size: 1.9rem;
		line-height: 1.25;
		color: var(--caramel);
		padding-left: 18px;
		border-left: 3px solid var(--biscuit);
	}

	.end {
		max-width: 46rem;
		padding-bottom: var(--section);
		display: grid;
		gap: 32px;
	}
	.pdf {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: clamp(22px, 4vw, 32px);
		border-radius: var(--radius-card);
		background: var(--latte);
	}
</style>
