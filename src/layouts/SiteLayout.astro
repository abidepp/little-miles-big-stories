---
// The page shell every page shares: <head>, header, footer and global styles.
// A page writes <SiteLayout title="..."> ...content... </SiteLayout>; the content
// lands where this file says <slot />. Everything in this --- block runs at build time.

import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_STRAPLINE, SITE_TAGLINE, SITE_PHILOSOPHY, CATEGORIES } from '../consts';
import { getSocial } from '../utils/journals';
import '../styles/global.css';

interface Props {
	title?: string; // omit on the homepage
	description?: string;
	image?: string; // absolute or root-relative URL for social previews
	type?: 'website' | 'article';
	publishedTime?: Date;
}

const { title, description = SITE_DESCRIPTION, image, type = 'website', publishedTime } = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} | Family Travel Journal`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : undefined;

const social = await getSocial();

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: CATEGORIES.journal.href, label: CATEGORIES.journal.label },
	{ href: CATEGORIES.guide.href, label: CATEGORIES.guide.label },
	{ href: CATEGORIES['family-travel'].href, label: CATEGORIES['family-travel'].label },
	{ href: '/destinations', label: 'Destinations' },
	{ href: '/about', label: 'About Us' },
	{ href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
function ariaCurrent(href: string) {
	if (currentPath === href) return 'page';
	if (href !== '/' && currentPath.startsWith(href + '/')) return 'true';
	return undefined;
}
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f3ee" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />

		<!-- Social previews: what Instagram DMs, WhatsApp, Facebook and Pinterest show for a shared link -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:title" content={title ?? SITE_TITLE} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		{ogImageURL && <meta property="og:image" content={ogImageURL} />}
		{ogImageURL && <meta property="og:image:width" content="1200" />}
		{ogImageURL && <meta property="og:image:height" content="630" />}
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		<meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />

		<Font cssVariable="--font-cormorant" preload />
		<Font cssVariable="--font-nunito-sans" preload />
		<Font cssVariable="--font-caveat" />
	</head>

	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<header class="site-header">
			<div class="wrap header-inner">
				<p class="label strapline">{SITE_STRAPLINE}</p>
				<a href="/" class="logo">Little Miles, <em>Big Stories</em></a>
				<nav aria-label="Main">
					<ul>
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href} aria-current={ariaCurrent(link.href)}>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<div class="footer-brand">
					<a href="/" class="logo">Little Miles, <em>Big Stories</em></a>
					<p class="script footer-tagline">{SITE_TAGLINE}</p>
					<p class="footer-philosophy">{SITE_PHILOSOPHY}</p>
				</div>

				<nav class="footer-nav" aria-label="Footer">
					<p class="label">Explore</p>
					<ul>
						{navLinks.slice(1).map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>

				<div class="footer-social">
					<p class="label">Follow along</p>
					<ul>
						<li>
							<a href={social.instagram} target="_blank" rel="noopener">
								<Icon name="instagram" size={18} /> Instagram
							</a>
						</li>
						{
							social.linktree && (
								<li>
									<a href={social.linktree} target="_blank" rel="noopener">
										<Icon name="link" size={18} /> All our links
									</a>
								</li>
							)
						}
						{
							social.email && (
								<li>
									<a href={`mailto:${social.email}`}>
										<Icon name="mail" size={18} /> {social.email}
									</a>
								</li>
							)
						}
						<li>
							<a href="/rss.xml">RSS feed</a>
						</li>
					</ul>
				</div>
			</div>
			<p class="wrap copyright">© {new Date().getFullYear()} {SITE_TITLE}. All stories and photographs are our own.</p>
		</footer>
	</body>
</html>

<style>
	/* ---------- Header ---------- */
	.site-header {
		border-bottom: 1px solid var(--line);
		background: var(--paper);
	}
	.header-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-block: clamp(20px, 3vw, 32px) 0;
	}
	.strapline {
		font-size: 0.68rem;
		margin-bottom: 10px;
	}
	.logo {
		font-family: var(--font-heading);
		font-size: clamp(1.9rem, 5vw, 2.8rem);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}
	.logo em {
		font-style: italic;
		color: var(--accent);
	}

	nav[aria-label='Main'] {
		width: 100%;
		margin-top: clamp(16px, 2.5vw, 24px);
		border-top: 1px solid var(--line);
	}
	nav[aria-label='Main'] ul {
		list-style: none;
		display: flex;
		justify-content: center;
		gap: clamp(16px, 3vw, 36px);
		padding-block: 14px;
		/* On phones the links scroll sideways instead of wrapping into a jumble */
		overflow-x: auto;
		scrollbar-width: none;
		white-space: nowrap;
	}
	nav[aria-label='Main'] a {
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		padding-block: 4px;
		border-bottom: 1px solid transparent;
	}
	nav[aria-label='Main'] a:hover {
		color: var(--ink);
	}
	nav[aria-label='Main'] a[aria-current] {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}
	@media (max-width: 900px) {
		nav[aria-label='Main'] ul {
			justify-content: flex-start;
		}
	}

	/* ---------- Footer ---------- */
	.site-footer {
		margin-top: clamp(64px, 10vw, 120px);
		background: var(--sand-soft);
		border-top: 1px solid var(--line);
		padding-block: clamp(48px, 7vw, 72px) 28px;
	}
	.footer-inner {
		display: grid;
		gap: 40px;
		grid-template-columns: 2fr 1fr 1fr;
	}
	.footer-brand .logo {
		font-size: 2rem;
	}
	.footer-tagline {
		font-size: 1.5rem;
		line-height: 1.3;
		margin-top: 14px;
	}
	.footer-philosophy {
		color: var(--muted);
		margin-top: 10px;
		max-width: 38ch;
	}
	.site-footer ul {
		list-style: none;
		margin-top: 12px;
		display: grid;
		gap: 8px;
	}
	.site-footer li a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--ink);
	}
	.site-footer li a:hover {
		color: var(--accent);
	}
	.copyright {
		margin-top: 48px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
		font-size: 0.85rem;
		color: var(--muted);
	}
	@media (max-width: 760px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}
</style>
