---
// The shell every page shares: <head>, header, footer, fonts and global styles.
// A page writes <SiteLayout title="…" description="…"> …content… </SiteLayout>;
// the content lands where this file says <slot />. This --- block runs at build time.
//
// To add a page later (e.g. "Our work"): create src/pages/our-work.astro using this
// layout, then add one line to `navLinks` below.

import { Font } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { getSingle, instagramUrl } from '../utils/content';
import '../styles/global.css';

interface Props {
	title?: string; // omit on the homepage
	description: string;
	image?: string; // social preview image URL (absolute or /_astro/…)
}

const { title, description, image } = Astro.props;
const { data: site } = await getSingle('site');

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · A family travel journal`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : undefined;
const instagram = instagramUrl(site.instagramHandle);

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/our-story', label: 'Our story' },
	{ href: '/journals', label: 'Journals' },
	{ href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fbf8f3" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Social previews: what Instagram DMs, WhatsApp and Facebook show for a shared link -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:title" content={title ?? site.title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		{ogImageURL && <meta property="og:image" content={ogImageURL} />}
		<meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />

		<Font cssVariable="--font-heading-face" preload />
		<Font cssVariable="--font-body-face" preload />
		<Font cssVariable="--font-hand-face" />
	</head>

	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="brand">
					<span class="brand-title">{site.title}</span>
					<span class="brand-tagline">{site.tagline}</span>
				</a>
				<nav aria-label="Main">
					<ul>
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<p class="hand footer-line">{site.footerLine}</p>
				<div class="footer-bottom">
					<p class="footer-title">{site.title}</p>
					<ul class="footer-links">
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
						<li>
							<a href={instagram} target="_blank" rel="noopener">
								<Icon name="instagram" size={18} /> @{site.instagramHandle}
							</a>
						</li>
					</ul>
				</div>
				<p class="copyright">© {new Date().getFullYear()} {site.title}. All stories and photographs are our own.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	/* ---------- Header ---------- */
	.site-header {
		border-bottom: 1px solid var(--sand);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap; /* on phones the links wrap below the title */
		gap: 14px 32px;
		padding-block: 18px;
	}
	.brand {
		display: grid;
		gap: 2px;
		max-width: 34rem;
	}
	.brand-title {
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1.1;
	}
	.brand-tagline {
		font-size: 0.8rem;
		color: var(--cocoa);
		line-height: 1.4;
	}
	nav ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px clamp(18px, 3vw, 30px);
	}
	nav a {
		display: inline-block;
		padding-block: 10px; /* comfortable tap target */
		font-size: 0.95rem;
		color: var(--cocoa);
		text-decoration: underline transparent 1.5px;
		text-underline-offset: 6px;
		transition: color 0.2s, text-decoration-color 0.2s;
	}
	nav a:hover {
		color: var(--espresso);
	}
	nav a[aria-current='page'] {
		color: var(--espresso);
		font-weight: 700;
		text-decoration-color: var(--caramel);
	}

	/* ---------- Footer: dark brown band ---------- */
	.site-footer {
		background: var(--espresso);
		color: var(--warm-white);
		padding-block: clamp(56px, 8vw, 88px) 28px;
	}
	.footer-line {
		font-size: clamp(2rem, 5vw, 3.2rem);
		color: var(--biscuit);
		max-width: 22ch;
	}
	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 32px;
		margin-top: clamp(32px, 5vw, 48px);
		padding-top: 24px;
		border-top: 1px solid rgba(232, 225, 214, 0.25);
	}
	.footer-title {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 700;
	}
	.footer-links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px 24px;
	}
	.footer-links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding-block: 8px;
	}
	.footer-links a:hover {
		color: var(--biscuit);
	}
	.copyright {
		margin-top: 28px;
		font-size: 0.85rem;
		color: var(--sand);
		opacity: 0.75;
	}
</style>
