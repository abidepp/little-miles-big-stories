---
// A photo, or, until there is one, a Latte-coloured placeholder that says what goes there.
//   <Photo src={data.photo} alt="…" placeholder="Photo: Ish on a trip" ratio="4 / 5" />
// When a real photo is added in the editor, Astro resizes it and serves WebP automatically.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src?: ImageMetadata;
	alt?: string;
	placeholder: string; // shown while there's no photo
	ratio?: string; // CSS aspect-ratio, e.g. "4 / 5"
	sizes?: string;
	eager?: boolean; // true for the first photo on a page
	class?: string;
}

const { src, alt = '', placeholder, ratio = '4 / 3', sizes = '(max-width: 820px) 100vw, 600px', eager = false, class: className } = Astro.props;
---

<div class:list={['photo', className]} style={`aspect-ratio: ${ratio}`}>
	{
		src ? (
			<Image
				src={src}
				alt={alt}
				widths={[480, 800, 1200]}
				sizes={sizes}
				loading={eager ? 'eager' : 'lazy'}
				fetchpriority={eager ? 'high' : 'auto'}
			/>
		) : (
			<span class="placeholder" role="img" aria-label={alt || placeholder}>
				{placeholder}
			</span>
		)
	}
	<slot />
</div>

<style>
	.photo {
		position: relative;
		border-radius: var(--radius-photo);
		background: var(--latte);
	}
	.photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: inherit;
	}
	.placeholder {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 24px;
		text-align: center;
		color: var(--espresso);
		font-size: 0.9rem;
		font-weight: 700;
		opacity: 0.7;
	}
</style>
