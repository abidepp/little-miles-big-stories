---
// One journal on the Journals page.
//  - "out now": big card with cover, tags, title, text, "Free" + Download the PDF
//  - "coming soon": smaller, quieter card (optionally with a link, e.g. "Tell us")
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { hasPage, type Journal } from '../utils/content';

interface Props {
	journal: Journal;
}

const { journal } = Astro.props;
const { title, status, tags, summary, cover, coverAlt, pdf, cta } = journal.data;
const page = hasPage(journal) ? `/journals/${journal.id}` : undefined;
---

{
	status === 'out-now' ? (
		<article class="journal">
			<Photo src={cover} alt={coverAlt} placeholder={`Cover photo: ${title}`} ratio="4 / 3" class="journal-photo" />
			<div class="journal-body">
				<ul class="tags">
					{tags.map((tag) => (
						<li class="tag">{tag}</li>
					))}
				</ul>
				<h3 class="h-md">{page ? <a href={page}>{title}</a> : title}</h3>
				{summary && <p class="lede">{summary}</p>}
				<div class="journal-actions">
					<span class="free hand">Free</span>
					{pdf ? (
						<a href={pdf} class="btn" download>
							<Icon name="download" size={18} /> Download the PDF
						</a>
					) : (
						<span class="btn btn-light" aria-disabled="true">
							PDF coming soon
						</span>
					)}
					{page && (
						<a href={page} class="read">
							Read the journal <Icon name="arrow" size={16} />
						</a>
					)}
				</div>
			</div>
		</article>
	) : (
		<article class="soon card">
			<p class="label">Coming soon</p>
			<h3 class="h-md">{title}</h3>
			{summary && <p>{summary}</p>}
			{cta && (
				<a href={cta.url} class="soon-link">
					{cta.label} <Icon name="arrow" size={16} />
				</a>
			)}
		</article>
	)
}

<style>
	.journal {
		display: grid;
		gap: clamp(24px, 4vw, 48px);
		align-items: center;
		background: var(--white);
		border: 1px solid var(--sand);
		border-radius: var(--radius-card);
		padding: clamp(14px, 2vw, 20px);
	}
	@media (min-width: 820px) {
		.journal {
			grid-template-columns: 1.1fr 1fr;
		}
	}
	.journal :global(.journal-photo) {
		border-radius: calc(var(--radius-card) - 6px);
	}
	.journal-body {
		padding: clamp(4px, 2vw, 20px);
	}
	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 18px;
	}
	.journal h3 {
		margin-bottom: 12px;
	}
	.journal h3 a:hover {
		color: var(--caramel);
	}
	.journal-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px 18px;
		margin-top: 24px;
	}
	.free {
		font-size: 1.9rem;
		color: var(--caramel);
	}
	[aria-disabled='true'] {
		cursor: default;
		color: var(--cocoa);
	}
	.read {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: 700;
		color: var(--caramel);
	}
	.read:hover {
		color: var(--caramel-dark);
	}

	.soon {
		background: var(--oat);
		border-color: transparent;
	}
	.soon h3 {
		margin-block: 8px;
	}
	.soon p:not(.label) {
		color: var(--cocoa);
	}
	.soon-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 14px;
		font-weight: 700;
		color: var(--caramel);
	}
	.soon-link:hover {
		color: var(--caramel-dark);
	}
</style>
