---
// One clickable journal card. Used on the homepage and on /journals.
//
// HOW PROPS WORK
// The parent passes data in like HTML attributes:
//   <JournalCard journal={entry} featured />
// and it arrives here in Astro.props. The `Props` interface tells TypeScript
// (and your editor) exactly what a parent is allowed to pass.

import { Image } from 'astro:assets';
import { formatDate, type Journal } from '../utils/journals';

interface Props {
	journal: Journal;
	featured?: boolean; // larger, side-by-side layout for the latest journal
	headingLevel?: 2 | 3; // keeps heading order correct on whichever page uses it
}

const { journal, featured = false, headingLevel = 3 } = Astro.props;
const { title, date, location, excerpt, cover, coverAlt } = journal.data;

// A capitalised variable can be used as a tag name: <Heading> renders as <h2> or <h3>.
const Heading = `h${headingLevel}`;
---

<a href={`/journals/${journal.id}`} class:list={['card', { featured }]}>
	<!-- The same transition:name is used on the journal page's cover, so with
	     <ClientRouter /> the photo animates from this card into the article. -->
	<div class="card-img" transition:name={`cover-${journal.id}`}>
		{
			cover ? (
				// <Image /> runs at build time: it resizes the photo to these widths,
				// converts to WebP, and writes srcset/sizes so phones download small files.
				<Image
					src={cover}
					alt={coverAlt ?? ''}
					widths={featured ? [640, 960, 1280] : [400, 800]}
					sizes={featured ? '(max-width: 720px) 100vw, 600px' : '(max-width: 720px) 100vw, 350px'}
					loading={featured ? 'eager' : 'lazy'}
				/>
			) : (
				<div class="img-placeholder" aria-hidden="true">📸</div>
			)
		}
		{location && <span class="badge">📍 {location}</span>}
	</div>

	<div class="card-body">
		<p class="meta"><time datetime={date.toISOString()}>{formatDate(date, 'month')}</time></p>
		<Heading class="card-title">{title}</Heading>
		{excerpt && <p class="excerpt">{excerpt}</p>}
		<span class="read-more" aria-hidden="true">Read the story →</span>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-hover);
	}

	.card-img {
		position: relative;
		height: 210px;
	}
	.card-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.badge {
		position: absolute;
		left: 12px;
		bottom: 12px;
		background: var(--surface);
		color: var(--text);
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 700;
	}

	.card-body {
		padding: 20px 22px 24px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.card-title {
		font-size: 1.3rem;
		margin-bottom: 8px;
	}
	.excerpt {
		color: var(--muted);
		font-size: 0.95rem;
		flex: 1;
	}
	.read-more {
		margin-top: 14px;
		color: var(--accent);
		font-weight: 700;
	}

	/* Featured variant */
	.featured {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
	}
	.featured .card-img {
		height: auto;
		min-height: 320px;
	}
	/* The grid row sets the height here, so pin the image to fill it. */
	.featured .card-img img {
		position: absolute;
		inset: 0;
	}
	.featured .card-body {
		padding: 32px;
		justify-content: center;
	}
	.featured .card-title {
		font-size: 1.8rem;
		margin-bottom: 12px;
	}

	@media (max-width: 720px) {
		.card-img {
			height: 190px;
		}
		.featured {
			grid-template-columns: 1fr;
		}
		.featured .card-img {
			min-height: 220px;
		}
		.featured .card-body {
			padding: 24px;
		}
	}
</style>
