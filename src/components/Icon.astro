---
// Small line icons, drawn inline so there's no icon font or extra download.
// Usage: <Icon name="instagram" />
interface Props {
	name: 'instagram' | 'mail' | 'link' | 'whatsapp' | 'facebook' | 'pinterest' | 'share' | 'copy' | 'check' | 'download' | 'pin' | 'arrow';
	size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'instagram' && (
			<>
				<rect x="3" y="3" width="18" height="18" rx="5" />
				<circle cx="12" cy="12" r="4" />
				<circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
			</>
		)
	}
	{
		name === 'mail' && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="2" />
				<path d="m3 7 9 6 9-6" />
			</>
		)
	}
	{
		name === 'link' && (
			<>
				<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
				<path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
			</>
		)
	}
	{name === 'whatsapp' && <path d="M4 20l1.3-4A8 8 0 1 1 8 18.7L4 20Zm5-11c0 3 3 6 6 6l1.2-1.4-2-1-1 .8a4 4 0 0 1-2.6-2.6l.8-1-1-2L9 9Z" />}
	{name === 'facebook' && <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8Z" />}
	{
		name === 'pinterest' && (
			<>
				<circle cx="12" cy="12" r="9" />
				<path d="M11 8.5c3-1 5.5.6 5 3.3-.4 2.2-2.6 3.3-4.2 2.2M11.8 10.5 9.5 20" />
			</>
		)
	}
	{
		name === 'share' && (
			<>
				<path d="M12 3v12M8 7l4-4 4 4" />
				<path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" />
			</>
		)
	}
	{
		name === 'copy' && (
			<>
				<rect x="8" y="8" width="12" height="12" rx="2" />
				<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
			</>
		)
	}
	{name === 'check' && <path d="m5 12 5 5 9-10" />}
	{
		name === 'download' && (
			<>
				<path d="M12 4v11M7 10l5 5 5-5" />
				<path d="M5 20h14" />
			</>
		)
	}
	{
		name === 'pin' && (
			<>
				<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
				<circle cx="12" cy="9.5" r="2.5" />
			</>
		)
	}
	{name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
